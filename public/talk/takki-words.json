    { "korean": "사랑을 받다", "romanization": "sarangeul batda", "meaning_zh": "被爱、受到喜爱", "part_of_speech": "词组", "example_ko": "많은 사람들에게 사랑을 받고 싶어요.", "example_zh": "希望能被很多人喜爱。", "tags": ["感受", "粉丝"] },
    { "korean": "어렵다", "romanization": "eoryeopda", "meaning_zh": "困难的", "part_of_speech": "形容词", "example_ko": "모두를 만족시키기는 어려워요.", "example_zh": "很难让所有人都满意。", "tags": ["基础", "描述"] },
    { "korean": "그러면", "romanization": "geureomyeon", "meaning_zh": "那么、那样的话", "part_of_speech": "连接词", "example_ko": "그러면 저도 힘이 나요.", "example_zh": "那样的话我也会有力量。", "tags": ["基础", "常用表达"] },
