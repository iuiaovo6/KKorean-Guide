    { "korean": "믿다", "romanization": "mitda", "meaning_zh": "相信、信赖", "part_of_speech": "动词", "example_ko": "저는 저를 믿어요.", "example_zh": "我相信我自己。", "tags": ["感受", "基础"] },
    { "korean": "맞다", "romanization": "matda", "meaning_zh": "正确、对的", "part_of_speech": "形容词", "example_ko": "제 생각이 맞을까요?", "example_zh": "我的想法是对的吗？", "tags": ["基础"] },
    { "korean": "그래야죠", "romanization": "geuraeyajyo", "meaning_zh": "得那样做啊（그렇게 해야지요 的缩略）", "part_of_speech": "词组", "example_ko": "힘들어도 그래야죠.", "example_zh": "就算辛苦也得这样啊。", "tags": ["口语", "常用表达"] },
    { "korean": "그냥", "romanization": "geunyang", "meaning_zh": "就这么、只是", "part_of_speech": "副词", "example_ko": "그냥 하고 싶은 걸 해요.", "example_zh": "就做自己想做的事。", "tags": ["口语", "常用表达"] },
    { "korean": "가다", "romanization": "gada", "meaning_zh": "去、走下去", "part_of_speech": "动词", "example_ko": "계속 이 길을 가고 싶어요.", "example_zh": "我想继续走这条路。", "tags": ["基础", "出行"] },
    { "korean": "하고 싶다", "romanization": "hago sipda", "meaning_zh": "想做……", "part_of_speech": "语法词组", "example_ko": "하고 싶은 게 너무 많아요.", "example_zh": "想做的事太多了。", "tags": ["基础", "感受"] },
    { "korean": "꾸준히", "romanization": "kkujunhi", "meaning_zh": "持续地、踏踏实实地", "part_of_speech": "副词", "example_ko": "꾸준히 연습하는 게 중요해요.", "example_zh": "持续练习很重要。", "tags": ["描述", "基础"] },
    { "korean": "간절히", "romanization": "ganjeolhi", "meaning_zh": "恳切地、迫切地", "part_of_speech": "副词", "example_ko": "간절히 바라면 이루어질 거예요.", "example_zh": "恳切地期盼的话会实现的。", "tags": ["感受", "描述"] },
    { "korean": "열심히", "romanization": "yeolsimhi", "meaning_zh": "努力地、认真地", "part_of_speech": "副词", "example_ko": "오늘도 열심히 할게요.", "example_zh": "今天我也会努力的。", "tags": ["基础", "描述"] },
    { "korean": "진심", "romanization": "jinsim", "meaning_zh": "真心、诚意", "part_of_speech": "名词", "example_ko": "제 진심이 통했으면 좋겠어요.", "example_zh": "希望我的真心能被传达。", "tags": ["感受", "舞台"] },
    { "korean": "통하다", "romanization": "tonghada", "meaning_zh": "相通、被传达", "part_of_speech": "动词", "example_ko": "진심은 통한다고 믿어요.", "example_zh": "我相信真心会被听见。", "tags": ["感受", "常用表达"] },
